<name>タモン中心 距離感マップ</name>
<Style id="s-hotel"><IconStyle><color>ff7A46D9</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>

<kml xmlns="http://www.opengis.net/kml/2.2"><Document>
<name>野方 ベビーカー散歩マップ</name>
<Style id="s-route"><IconStyle><color>ffC06F2A</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s-lunch"><IconStyle><color>ff5A8A1E</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s-sweet"><IconStyle><color>ff1E57C8</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
<Style id="s-cafe"><IconStyle><color>ffB34F8A</color><Icon><href>http://maps.google.com/mapfiles/kml/paddle/wht-blank.png</href></Icon></IconStyle></Style>
